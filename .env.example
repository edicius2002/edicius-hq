# Local Docker Compose / Vite defaults (copy to .env as needed)
WEB_PORT=5173
API_PORT=8000

# Browser-facing API base URL (host machine, not the Docker service name)
VITE_API_URL=http://localhost:8000

# Comma-separated origins allowed by the API CORS middleware
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# How many Google Flights requests one collection day may spend. The endpoint
# is unmetered; the real limit is how much traffic one address can send before
# it stops being answered, so this is a self-imposed ceiling, not a quota.
FARES_DAILY_REQUEST_BUDGET=300
