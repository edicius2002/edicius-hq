# Local Docker Compose / Vite defaults (copy to .env as needed)
WEB_PORT=5173
API_PORT=8000

# Browser-facing API base URL (host machine, not the Docker service name).
#
# Read at BUILD time by `apps/web/src/shared/api/config.ts`, so changing it in
# a deployed environment needs a rebuild, not a restart.
#
# Deployed, this is the API's Tailscale Serve hostname — from
# `tailscale serve status`, no trailing slash:
#   VITE_API_URL=https://<machine>.<tailnet>.ts.net
# Leaving the localhost default in a deployed build points the browser at *the
# visitor's own machine*, which is a failure that looks like a working build.
VITE_API_URL=http://localhost:8000

# Comma-separated origins allowed by the API CORS middleware.
#
# This is what lets the browser accept the API's responses. It is NOT access
# control: CORS is a browser policy sent in a response header, and `curl` never
# asks for it. What restricts access is the tailnet, not this line.
#
# Deployed, append the Vercel origin, keeping the local ones so `npm run dev`
# still works:
#   CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://<project>.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# How many Google Flights requests one collection day may spend. Unset — the
# default — means there is no ceiling at all, which is deliberate: the endpoint
# is unmetered, the real limit is how much traffic one address can send before
# it stops being answered, and that number is unknown and deliberately
# unprobed. What bounds a pass is the three-second gap between requests and the
# one-pass-at-a-time lock, which bound the rate rather than a total. Set a
# number here to put the whole ceiling back; `0`, `off` or `none` say the
# default out loud for an environment that would rather keep the line.
# FARES_DAILY_REQUEST_BUDGET=off

# Leave the official SKY booking-API fallback disabled unless the collector
# should supplement Google H2 nulls with tax-inclusive SKY totals.
SKY_OFFICIAL_LOOKUP_ENABLED=false
