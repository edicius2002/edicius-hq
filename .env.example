# Local Docker Compose / Vite defaults (copy to .env as needed)
WEB_PORT=5173
API_PORT=8000

# Browser-facing API base URL (host machine, not the Docker service name)
VITE_API_URL=http://localhost:8000

# Comma-separated origins allowed by the API CORS middleware
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Travelpayouts Data API token (AIR-02, the non-scraper fare provider).
# Get one at https://www.travelpayouts.com/programs/100/tools/api after
# registering as a partner. Server-side only — never prefix it with VITE_,
# which would ship it to the browser.
TRAVELPAYOUTS_TOKEN=
# Partner ID that goes with the token. `show_to_affiliates=true` filters the
# price cache to searches made under this marker, which is what the docs
# recommend and what keeps the numbers comparable between passes.
TRAVELPAYOUTS_MARKER=
