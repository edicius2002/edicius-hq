# Local Docker Compose / Vite defaults (copy to .env as needed)
# Neon deploy writes DATABASE_URL (pooled application traffic) and
# DATABASE_URL_UNPOOLED (migrations and dumps) to the ignored root .env.local.
# Keep both server-only; never prefix either name with VITE_.
WEB_PORT=5173
API_PORT=8000

# Browser-facing API base URL (host machine, not the Docker service name).
#
# Read at BUILD time by `apps/web/src/shared/api/config.ts`, so changing it in
# a deployed environment needs a rebuild, not a restart.
#
# Local development only. Production reads Neon and the static map geography
# shipped with the web app, so it does not set this variable.
VITE_API_URL=http://localhost:8000

# Public browser Supabase Auth configuration.
VITE_SUPABASE_URL=https://abndifkxpfppmllgxfnu.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_in_ignored_dotenv

# Staged Neon browser cutover. The Data API URL is public; DATABASE_URL is not.
# Leave VITE_DATA_BACKEND unset until Auth, RPCs, queues, and collectors pass.
# VITE_DATA_BACKEND=neon
# VITE_NEON_DATA_API_URL=https://replace-with-neon-data-api-url/neondb/rest/v1

# Comma-separated origins allowed by the API CORS middleware.
#
# This is what lets the browser accept the API's responses. It is NOT access
# control: CORS is a browser policy sent in a response header, and `curl` never
# asks for it. What restricts access is the Supabase JWT every route requires,
# and the API only listening on this machine — not this line.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# How many Google Flights requests one collection day may spend. Unset — the
# default — means there is no ceiling at all, which is deliberate: the endpoint
# is unmetered, the real limit is how much traffic one address can send before
# it stops being answered, and that number is unknown and deliberately
# unprobed. What bounds a pass is the three-second gap between requests and the
# one-pass-at-a-time lock, which bound the rate rather than a total. Set a
# number here to put the whole ceiling back; `0`, `off` or `none` say the
# default out loud for an environment that would rather keep the line.
# FARES_DAILY_REQUEST_BUDGET=off

# Leave the official SKY booking-API fallback disabled unless the collector
# should supplement Google H2 nulls with tax-inclusive SKY totals.
SKY_OFFICIAL_LOOKUP_ENABLED=false

# `SUPABASE_URL` is the exact JWT issuer input for API verification.
# Set API_AUTH_BACKEND=neon only when a private FastAPI deployment must accept
# Better Auth tokens from the exact production origin; its JWKS stays public.
# API_AUTH_BACKEND=neon
# `SUPABASE_SECRET_KEY` is administrative-only for Airfare and importer work;
# never prefix it with VITE_ or use it for browser or JWT verification.
SUPABASE_URL=https://abndifkxpfppmllgxfnu.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_replace_in_ignored_dotenv
# Pi collector service-role configuration. The owner UUID scopes every Data API request.
EDICIUS_OWNER_ID=11111111-1111-1111-1111-111111111111
COLLECTOR_SUPABASE_TIMEOUT_SECONDS=15
# For a staged Pi cutover, install COLLECTOR_DATA_BACKEND=neon and the pooled
# DATABASE_URL in the protected Pi collectors.env through the operator channel.
# Keep the Supabase variables there for rollback until the Neon flows pass.
# COLLECTOR_DATA_BACKEND=neon
AIRFARE_DATA_BACKEND=local
AIRFARE_SYNC_ENABLED=false
# After historical Airfare rows are verified in Neon, set this in the protected
# Pi environment to publish future journal changes through direct Postgres.
# AIRFARE_SYNC_BACKEND=neon
AIRFARE_SUPABASE_TIMEOUT_SECONDS=15
AIRFARE_SUPABASE_BATCH_SIZE=250
