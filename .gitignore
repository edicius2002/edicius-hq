# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/
*.sw?

# Env / secrets
.env
.env.*
!.env.example

# Dependencies / build
node_modules/
dist/
build/
coverage/
.turbo/
*.tsbuildinfo

# Tooling caches
.eslintcache
.prettiercache

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# API local data (bars cache, KV)
services/api/.local-data/
.local-data/

# Logs / temp
*.log
*.tmp
*.temp

# Personal finance exports (never commit)
*.csv
*.tsv
*backup*.json

# Keep deliberate examples only
!examples/
!examples/**/*.csv

# Reference data that ships with the code. The blanket rule above exists so a
# bank export can never be committed by accident; this is a public-domain
# airport table, and it has to be in the repository for the search to work.
!services/api/app/data/*.tsv
!examples/**/*.json

# Test fixtures: structure of a real export, none of its data. Anything added
# here must be anonymised — no names, emails, phone numbers, clients or rates.
!apps/web/src/**/fixtures/*.csv

# Licensed font binaries (keep README)
apps/web/public/fonts/*
!apps/web/public/fonts/README.md

# Agent worktrees live inside the repo; they are checkouts, not content.
.claude/worktrees/

# CCB runtime state: agent sessions, worktrees and workspace bindings.
.ccb/
