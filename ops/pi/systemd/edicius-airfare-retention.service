[Unit]
Description=Resume verified Edicius Airfare departure retention
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
TimeoutStartSec=2h
User=edicius-collector
Group=edicius-collector
WorkingDirectory=/opt/edicius-hq/current
EnvironmentFile=/etc/edicius-hq/collectors.env
Environment=HOME=/var/lib/edicius-hq
Environment=LOCAL_DATA_DIR=/var/lib/edicius-hq
ExecStart=/usr/bin/flock -n -E 75 /var/lib/edicius-hq/locks/airfare.lock /opt/edicius-hq/current/services/api/.venv/bin/python /opt/edicius-hq/current/scripts/fares-retention.py --apply
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/edicius-hq
UMask=0077
