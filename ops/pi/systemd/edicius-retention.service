[Unit]
Description=Prune terminal Edicius Supabase operational history
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
TimeoutStartSec=10min
User=edicius-collector
Group=edicius-collector
WorkingDirectory=/opt/edicius-hq/current
EnvironmentFile=/etc/edicius-hq/collectors.env
Environment=HOME=/var/lib/edicius-hq
Environment=LOCAL_DATA_DIR=/var/lib/edicius-hq
ExecStart=/opt/edicius-hq/current/services/api/.venv/bin/python /opt/edicius-hq/current/scripts/prune-operational-history.py --apply
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/edicius-hq
UMask=0077
