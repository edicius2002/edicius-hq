{
  "name": "edicius-hq",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Edicius HQ monorepo",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "prepare": "node scripts/install-hooks.mjs",
    "dev": "npm run dev -w web",
    "dev:web": "npm run dev -w web",
    "dev:api": "npm run api:dev",
    "build": "npm run build -w web",
    "start": "npm run build && node scripts/serve.mjs",
    "typecheck": "npm run typecheck -w web",
    "test": "npm run test -w web",
    "lint:api": "node scripts/api.mjs lint",
    "typecheck:api": "node scripts/api.mjs typecheck",
    "format:api": "node scripts/api.mjs format",
    "test:api": "npm run api:test",
    "api:dev": "node scripts/api.mjs dev",
    "api:test": "node scripts/api.mjs test",
    "fares:collect": "node scripts/api.mjs fares-collect",
    "fares:check": "node scripts/api.mjs fares-check",
    "fares:backfill": "node scripts/api.mjs fares-backfill",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.68.0"
  }
}
