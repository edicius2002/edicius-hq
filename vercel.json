{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build -w web",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    { "source": "/api/auth/:path*", "destination": "/api/auth?__auth_path=:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
